# Tréso-Solution · v1.5 · serveur Apache
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# 1. Une seule adresse : https://www.treso-solution.fr
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.treso-solution.fr%{REQUEST_URI} [R=301,L]

# 2. Anciennes adresses qui n'existent plus
RewriteRule ^presentation/?$ / [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^notre-solution-[a-z0-9-]+/?$ /notre-solution [R=301,L]

# 3. Les adresses en .html redirigent vers l'adresse sans extension
RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# 4. Pas de barre oblique finale (évite les doublons)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5. Une adresse sans extension affiche le fichier .html correspondant
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
